<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Broiler.CSS.Dom</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings> <!-- MaiRat: please leave disabled - so everyone can trace back used types (even with notepad) -->
    <Nullable>enable</Nullable>
    <Description>Selector matching and DOM-facing CSS services over the canonical Broiler DOM.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.CSS\Broiler.CSS.csproj" />
    <!-- Phase 1 item 4: resolve the canonical Broiler.Dom kernel through $(BroilerDomPath)
         (nested checkout for standalone builds; single root checkout in the main solution)
         so the main build does not create a second Broiler.Dom project node. -->
    <ProjectReference Include="$(BroilerDomPath)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.CSS.Dom.Tests" />
  </ItemGroup>

</Project>
