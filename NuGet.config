<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for Broiler.CSS.

    <clear /> drops whatever sources the machine happens to have configured, so a
    restore resolves the same way on every developer box and in CI.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="broiler-github" value="https://nuget.pkg.github.com/Broiler-Platform/index.json" />
  </packageSources>
  <disabledPackageSources><clear /></disabledPackageSources>

  <!--
    Source mapping keeps the two feeds in their lanes. Broiler.* may come from the
    Broiler-Platform GitHub Packages feed or from nuget.org once published; everything
    else resolves from nuget.org only.

    Broiler dependencies are PackageReferences. The more specific Broiler.* mapping
    sends them to GitHub Packages, which requires read:packages authentication even
    for public packages. CI supplies its job token through NuGet's credential
    environment variable; developers configure credentials outside this repository.

    Credentials are deliberately absent. Never commit a token here; see the README
    section "Consuming Broiler packages from GitHub Packages".
  -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="broiler-github">
      <package pattern="Broiler.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
